  "naming": {
    "asset_pattern": "RMS_[Category]_[Descriptor]_[Version]",
    "recommended_audio_pattern": "RMS_[Category]_[Descriptor]_[BPM]BPM_[Version].[ext]",
    "example": "RMS_Beat_DarkTrap_140BPM_v1.wav",
    "project_pattern": "RMS_Project_[CreatorOrClient]_[Title]_[Version]"
  },
  "catalog_fields": [
    "asset_id",
    "file_name",
    "drive_file_id",
    "canonical_folder",
    "asset_type",
    "genre",
    "mood",
    "bpm",
    "musical_key",
    "version",
    "membership_tier",
    "public_preview_allowed",
    "commercial_use_status",
    "third_party_content_status",
    "rights_review_status",
    "checksum",
    "created_at",
    "updated_at"
  ],
  "pi_events": {
    "membership_activated": ["assign_tier", "grant_identity_bound_access", "issue_secure_access_reference", "send_onboarding", "audit"],
    "membership_upgraded": ["revoke_previous_tier", "grant_new_tier", "notify", "audit"],
    "membership_canceled": ["revoke_member_library_access", "archive_entitlement", "notify", "audit"],
    "new_content_added": ["validate_asset", "update_new_this_week", "prepare_discord_announcement", "audit"]
  },
  "stripe_boundary": {
    "status": "intentionally_not_wired",
    "rule": "Stripe native events will be translated into RMS PI membership events after storage/access tests pass.",
    "do_not_create_fake_stripe_event_names": true
  }
}
